# ==========================================
# SynapseCash - Git Ignore Configuration
# ==========================================

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Python build and distribution
build/
dist/
*.egg-info/
.eggs/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/
conda-bld/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# SynapseCash encryption key
security/fernet.key

# SQLite databases
*.db
*.sqlite
*.sqlite3
*.db-journal

# Logs
logs/
*.log

# Pytest
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml/

# Ruff cache
.ruff_cache/

# VS Code settings
.vscode/

# PyCharm settings
.idea/

# Jupyter Notebook
.ipynb_checkpoints/

# Windows temporary files
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS temporary files
.DS_Store
.AppleDouble
.LSOverride

# Temporary and backup files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Debugging files
*.stackdump