# ==========================================
# SynapseCash - Git Ignore
# ==========================================

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/
.eggs/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Code quality tools
.ruff_cache/

# IDE and editor settings
.vscode/
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log

# SQLite database files
database/*.db
database/*.sqlite
database/*.sqlite3

# Temporary and backup files
*.tmp
*.bak
*.old
*~

# Environment variables and secrets
.env
.env.*
!.env.example

# GTK temporary files
*.ui~
